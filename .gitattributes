# GitHub Linguist Language Configuration
# Ensures multi-language ecosystem (JavaScript, Go, Rust, Python, Shell, PowerShell, Dockerfile, Makefile) is detected

*.js linguist-detectable=true
*.go linguist-detectable=true
*.rs linguist-detectable=true
*.py linguist-detectable=true
*.sh linguist-detectable=true
*.ps1 linguist-detectable=true
Makefile linguist-detectable=true
Dockerfile linguist-detectable=true

# Exclude large raw JSON database files from code stats
*.json linguist-detectable=false
*.json linguist-documentation=false

# Mark assets and vendor files
assets/* linguist-vendored
icons/* linguist-vendored
node_modules/* linguist-vendored
